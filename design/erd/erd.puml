@startuml ERD_QuanLyNhaHang
' ERD toàn hệ thống — Hệ thống quản lý nhà hàng Bò Né Mỹ Cảnh (đồ án CNPM)
' Chỉ thể hiện tên bảng + tên thuộc tính + đường kết nối giữa các bảng.
' Quy ước: PK surrogate = <Bảng>ID (INT); mã nghiệp vụ = Ma...; ChiTiet* dùng PK ghép.
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam DefaultFontName "Segoe UI"
skinparam DefaultFontSize 12
skinparam nodesep 14
skinparam ranksep 34
skinparam roundCorner 6
skinparam classAttributeIconSize 0

entity "Role" as Role {
  RoleID
  RoleName
  Description
}

entity "User" as User {
  UserID
  Username
  PasswordHash
  FullName
  RoleID
  Status
  FailedLoginCount
  LastLoginAt
  CreatedAt
  UpdatedAt
}

entity "Ban" as Ban {
  BanID
  MaBan
  KhuVuc
  SucChua
  TrangThai
  GhiChu
  DangSuDung
}

entity "MonAn" as MonAn {
  MonAnID
  MaSanPham
  TenMon
  LoaiMon
  DonGia
  TrangThai
  MoTa
  DangSuDung
}

entity "PhieuDatBan" as PhieuDatBan {
  PhieuDatBanID
  BanID
  NhanVienTiepNhanID
  TenKhach
  SoDienThoai
  SoNguoi
  ThoiGianDat
  HinhThucDat
  GhiChu
  TrangThai
  ThoiGianTao
  ThoiGianNhanBan
  ThoiGianHuy
}

entity "PhieuOrder" as PhieuOrder {
  PhieuOrderID
  BanID
  NhanVienPhucVuID
  ThoiGianTao
  TrangThai
  TongTamTinh
}

entity "ChiTietOrder" as ChiTietOrder {
  PhieuOrderID
  SoDong
  MonAnID
  NhanVienXacNhanID
  SoLuong
  DonGia
  ThanhTien
  GhiChu
  TrangThai
  ThoiGianTao
  ThoiGianChot
  ThoiGianXong
  ThoiGianPhucVu
}

entity "HoaDon" as HoaDon {
  HoaDonID
  MaHoaDon
  PhieuOrderID
  NhanVienThuNganID
  MaBanSnapshot
  TongTienMon
  TyLeVat
  TienVat
  TongThanhToan
  HinhThucTT
  TienKhachDua
  TienThua
  MaGiaoDich
  ThoiGianTao
  SoLanIn
}

entity "ChiTietHoaDon" as ChiTietHoaDon {
  HoaDonID
  MonAnID
  TenMon
  SoLuong
  DonGia
  ThanhTien
}

entity "NhaCungCap" as NhaCungCap {
  NhaCungCapID
  TenNCC
  SoDienThoai
  DiaChi
  DangSuDung
}

entity "NguyenLieu" as NguyenLieu {
  NguyenLieuID
  TenNVL
  DonViTinh
  TonHienTai
  DinhMucToiThieu
  ThoiGianCapNhatTon
  DangSuDung
}

entity "PhieuNhapKho" as PhieuNhapKho {
  PhieuNhapKhoID
  MaPhieuNhap
  NhaCungCapID
  NhanVienLapID
  NgayNhap
  TongGiaTri
  GhiChu
  ThoiGianTao
}

entity "ChiTietNhapKho" as ChiTietNhapKho {
  PhieuNhapKhoID
  NguyenLieuID
  SoLuong
  DonGia
  ThanhTien
  GhiChu
}

entity "PhieuXuatKho" as PhieuXuatKho {
  PhieuXuatKhoID
  MaPhieuXuat
  NhanVienLapID
  NgayXuat
  TongGiaTri
  GhiChu
  ThoiGianTao
}

entity "ChiTietXuatKho" as ChiTietXuatKho {
  PhieuXuatKhoID
  NguyenLieuID
  SoLuong
  DonGia
  ThanhTien
  GhiChu
}

Role          -- User
User          -- PhieuDatBan
User          -- PhieuOrder
User          -- ChiTietOrder
User          -- HoaDon
User          -- PhieuNhapKho
User          -- PhieuXuatKho
Ban           -- PhieuDatBan
Ban           -- PhieuOrder
MonAn         -- ChiTietOrder
MonAn         -- ChiTietHoaDon
PhieuOrder    -- ChiTietOrder
PhieuOrder    -- HoaDon
HoaDon        -- ChiTietHoaDon
NhaCungCap    -- PhieuNhapKho
PhieuNhapKho  -- ChiTietNhapKho
NguyenLieu    -- ChiTietNhapKho
PhieuXuatKho  -- ChiTietXuatKho
NguyenLieu    -- ChiTietXuatKho
@enduml
